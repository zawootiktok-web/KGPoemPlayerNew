<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KGPoem" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/purple</item>
        <item name="android:colorPrimary">@color/purple</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
    </style>

    <style name="Theme.KGPoem.Karaoke" parent="Theme.KGPoem">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/purple_dark</item>
        <item name="android:navigationBarColor">#20134C</item>
    </style>
</resources>
