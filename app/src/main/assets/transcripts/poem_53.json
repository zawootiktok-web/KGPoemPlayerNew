{
  "version": 5,
  "source": "Wording preserved from supplied transcript; clauses split and timing windows normalized for karaoke playback.",
  "title": "အမြီးတန်းလန်းနဲ့ ကြွက်",
  "lines": [
    {
      "start": 5.0,
      "end": 10.94,
      "text": "မြေကြီးကို တူးကာယက်၊"
    },
    {
      "start": 10.94,
      "end": 18.12,
      "text": "ညအခါမှာ လမ်းလျှောက်ထွက်။"
    },
    {
      "start": 18.12,
      "end": 25.68,
      "text": "လူတွေမြင်ရင် ကျွန်တော့်ကို နှက်၊"
    },
    {
      "start": 25.68,
      "end": 31.23,
      "text": "အမြီးတန်းလန်းနဲ့ ကြွက်။"
    },
    {
      "start": 31.23,
      "end": 37.22,
      "text": "ဟိုပေါ်တက် သည်ပေါ်တက်၊"
    },
    {
      "start": 37.22,
      "end": 44.35,
      "text": "အိုးခွက်ပန်းကန် ပက်လက်လန်။"
    },
    {
      "start": 44.35,
      "end": 51.68,
      "text": "အကြွင်းအကျန်ကို ယက်၊"
    },
    {
      "start": 51.68,
      "end": 57.47,
      "text": "တွေ့ကရာကိုဖျက်။"
    },
    {
      "start": 57.47,
      "end": 64.82,
      "text": "အချင်းချင်းဆို ညီအစ်ကို၊"
    },
    {
      "start": 64.82,
      "end": 70.58,
      "text": "မိလိုချစ်တဲ့ကြွက်။"
    },
    {
      "start": 70.58,
      "end": 78.61,
      "text": "သူ့တွင်း ကိုယ့်တွင်း ပြေးကာဆင်း၊"
    },
    {
      "start": 78.61,
      "end": 83.7,
      "text": "ရင်းနှီးကြတဲ့ကြွက်။"
    }
  ]
}
